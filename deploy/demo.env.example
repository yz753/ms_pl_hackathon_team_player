# Copy this to deploy/demo.env and fill in your Azure project settings.
# uv reads this file on macOS, Windows and Linux; no export or shell expansion.
TEAM_PLAYER_AI=foundry
TEAM_PLAYER_REASONING=low
TEAM_PLAYER_IDENTITY=cli
FOUNDRY_PROJECT_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT
FOUNDRY_MODEL=gpt-5-mini
TEAM_PLAYER_BLOB_ACCOUNT_URL=https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net
TEAM_PLAYER_ANALYSIS_CONTAINER=analysis
TEAM_PLAYER_CACHE=runs/demo_cache
TEAM_PLAYER_MATCH=matches/match_demo_2026_27_MW01_T_G.jsonl
TEAM_PLAYER_FAVOURITE=T09
TEAM_PLAYER_SEASON=2026-27
TEAM_PLAYER_PORT=8001
