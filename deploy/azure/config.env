# Team Player · Azure settings. Edit once, then run the numbered scripts from the repo root:
#   bash deploy/azure/01_storage.sh ... bash deploy/azure/06_check.sh
# Values below were taken from your existing deploy/app-service.sh and Foundry project.

# --- where everything lives -------------------------------------------------------
export SUBSCRIPTION_ID='8d325680-f74f-4368-9f4b-e1c77abb609e'
export RESOURCE_GROUP='rg-s2155699-2564'
export LOCATION='uksouth'

# --- Microsoft Foundry (already created by you) --------------------------------------
export FOUNDRY_PROJECT_ENDPOINT='https://s2155699-3233-resource.services.ai.azure.com/api/projects/s2155699-3233'
export FOUNDRY_MODEL='gpt-5-mini'          # the DEPLOYMENT name shown in Foundry > Models + endpoints
export FOUNDRY_RESOURCE_ID='/subscriptions/8d325680-f74f-4368-9f4b-e1c77abb609e/resourceGroups/rg-s2155699-2564/providers/Microsoft.CognitiveServices/accounts/s2155699-3233-resource'

# --- storage (3-24 lowercase letters/digits, globally unique) --------------------------
export STORAGE_ACCOUNT='tpdata2155699'
export STORAGE_URL="https://${STORAGE_ACCOUNT}.blob.core.windows.net"

# --- batch jobs (Azure Container Apps Jobs) ---------------------------------------------
export ACR_NAME='tpworker2155699'           # container registry (5-50 letters/digits, globally unique)
export IMAGE_TAG='v1'
export JOBS_ENV='tp-jobs-env'
export JOB_IDENTITY='tp-jobs-identity'
export REPLICAS=20                          # parallel replicas per job
export REPLICA_CPU=2                        # vCPU per replica (also the worker processes per replica)
export REPLICA_MEMORY='4Gi'

# --- web app (Azure App Service) ---------------------------------------------------------
export APP_NAME='football-performance-analysis-team-player-yz753'
export PLAN_NAME="${APP_NAME}-plan"
export PLAN_SKU='P0V3'                      # 1 vCPU / 4 GB: enough for the history index; B2 also works

# Viewer history: Azure Blob, verified 2021-22 database.
export TEAM_PLAYER_BLOB_ACCOUNT_URL="$STORAGE_URL"
export TEAM_PLAYER_ANALYSIS_CONTAINER=analysis
export TEAM_PLAYER_CACHE=/tmp/team_player_azure_20261027
unset TEAM_PLAYER_HISTORY_DB
